# ==============================================================================
# Environment Variable Template  (.env.example)
# ------------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values for your local environment:
#     cp .env.example .env
#
# The real ".env" file is git-ignored and MUST NEVER be committed; only this
# ".env.example" template is committed, purely to document the configuration
# contract for developers. Every variable below also has a safe default in
# src/config/index.js, so a missing ".env" is tolerated at runtime and the
# server still binds to the original 127.0.0.1:3000 address.
# ==============================================================================

# Node runtime environment: development | production
NODE_ENV=development

# HTTP server bind address and port
PORT=3000
HOST=127.0.0.1

# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
